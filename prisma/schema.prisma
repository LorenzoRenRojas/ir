generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  password          String?
  passwordChangedAt DateTime?
  name             String?
  image            String?
  role             String    @default("user")
  subscriptionTier String    @default("free")
  stripeCustomerId String?
  onboardingDone   Boolean   @default(false)
  notifyDigest     Boolean   @default(true)
  notifyDeadlines  Boolean   @default(true)
  notifyRadar      Boolean   @default(true)
  notifyInstant    Boolean   @default(false)
  // Feed appearance defaults — applied when the dashboard first loads.
  feedEligibleOnly     Boolean @default(true)
  feedHideSaved        Boolean @default(true)
  feedDensity          String  @default("comfortable")
  feedDefaultDueWithin String  @default("")
  feedMinMatch         Int     @default(0)
  // Referral tracking — referralCode is this user's shareable code (generated
  // lazily), referredBy stores the userId of whoever referred them.
  referralCode     String?   @unique
  referredBy       String?
  createdAt        DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  companyProfile     CompanyProfile?
  savedContracts     SavedContract[]
  generatedDocuments GeneratedDocument[]
  teamMembers        TeamMember[]
  userEmbedding      UserEmbedding?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CompanyProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  companyName       String
  uei               String?
  website           String?
  yearFounded       Int?
  businessTypes     String   @default("[]")
  naicsCodes        String   @default("[]")
  contractSizePrefs String   @default("[]")
  contractTypePrefs String   @default("[]")
  geoPrefs          String   @default("[]")
  certifications    String   @default("[]")
  clearanceLevel       String?
  orgSize              String?
  annualRevenue        String?
  agencyHistory        String   @default("[]")
  contractVehicles     String   @default("[]")
  capabilityStatement  String?
  pastPerformance      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedContract {
  id          String   @id @default(cuid())
  userId      String
  contractId  String
  samNoticeId String?
  title       String
  agency      String
  value       Float?
  deadline    DateTime?
  matchScore  Int?
  status      String   @default("saved")
  notes       String?
  scorecard   String? // JSON: bid/no-bid factor ratings {customer,fit,pastPerf,competition,resources,price}
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contractId])
  @@index([deadline])
}

model GeneratedDocument {
  id            String   @id @default(cuid())
  userId        String
  type          String   @default("proposal")
  title         String
  content       String
  noticeId      String?
  contractTitle String?
  agencyName    String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Every outbound email attempt is recorded here so failures are visible
// in the admin dashboard instead of dying silently in serverless logs.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  status    String // sent | failed | skipped_no_key
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Full-market contract store, refreshed daily by cron from paginated SAM.gov
// pulls (limit=1000/page). Scoring reads from here instead of a 100-row cache.
model ContractCache {
  noticeId   String   @id
  payload    String // full Contract JSON
  naicsCode  String   @default("")
  setAside   String   @default("")
  postedDate DateTime?
  deadline   DateTime?
  updatedAt  DateTime @updatedAt

  @@index([naicsCode])
  @@index([postedDate])
  @@index([deadline])
}

// Every notice that ages out of ContractCache lands here instead of
// vanishing — the historical dataset (award research, market trends, future
// training data) accumulates for free from syncs we already run. Time is
// the moat: this table only gets more valuable and can't be copied.
model ContractArchive {
  noticeId   String   @id
  payload    String // full Contract JSON as last seen
  naicsCode  String   @default("")
  setAside   String   @default("")
  postedDate DateTime?
  deadline   DateTime?
  archivedAt DateTime @default(now())

  @@index([naicsCode])
  @@index([postedDate])
}

// Tiny key-value store for counters and operational state (e.g. the daily
// SAM.gov API request budget shared across all serverless instances).
model Kv {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Coming-soon page email captures
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members TeamMember[]
  invites TeamInvite[]
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  userId      String
  role        String   @default("member")
  permissions String   @default("{\"canSaveContracts\":true,\"canGenerateDocs\":false,\"canManageWatchlist\":true,\"canEditCompanyProfile\":false}")
  joinedAt    DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// Stores Voyage AI embeddings for contracts keyed by SAM.gov noticeId
model ContractEmbedding {
  noticeId  String   @id
  embedding String   // JSON float array (voyage-3-lite: 512 dims)
  model     String   @default("voyage-3-lite")
  createdAt DateTime @default(now())
}

// Per-user learned preference vector (EMA of saved contract embeddings)
model UserEmbedding {
  userId              String   @id
  preferenceEmbedding String   // JSON float array
  saveCount           Int      @default(0)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamInvite {
  id         String    @id @default(cuid())
  teamId     String
  email      String
  token      String    @unique @default(cuid())
  role       String    @default("member")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}
